{
  "name": "@hanzogui/themes",
  "version": "8.3.1",
  "gitHead": "a49cc7ea6b93ba384e77a4880ae48ac4a5635c14",
  "files": [
    "dist",
    "src",
    "types",
    "v3-themes.cjs",
    "v3-themes.d.ts",
    "v3-themes",
    "v3.cjs",
    "v3.d.ts",
    "v3",
    "v4.cjs",
    "v4.d.ts",
    "v4",
    "v5-subtle.cjs",
    "v5-subtle.d.ts",
    "v5-subtle",
    "v5.cjs",
    "v5.d.ts",
    "v5"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/esm/index.js",
      "browser": "./dist/esm/index.js",
      "module": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./types": {
      "types": "./types/index.d.ts"
    },
    "./types/*": {
      "types": "./types/*.d.ts"
    },
    "./v3": {
      "types": "./types/v3.d.ts",
      "react-native": "./dist/esm/v3.js",
      "browser": "./dist/esm/v3.js",
      "module": "./dist/esm/v3.js",
      "import": "./dist/esm/v3.js",
      "require": "./dist/cjs/v3.js",
      "default": "./dist/esm/v3.js"
    },
    "./v3-themes": {
      "types": "./types/v3-themes.d.ts",
      "react-native": "./dist/esm/v3-themes.js",
      "browser": "./dist/esm/v3-themes.js",
      "module": "./dist/esm/v3-themes.js",
      "import": "./dist/esm/v3-themes.js",
      "require": "./dist/cjs/v3-themes.js",
      "default": "./dist/esm/v3-themes.js"
    },
    "./v4": {
      "types": "./types/v4.d.ts",
      "react-native": "./dist/esm/v4.js",
      "browser": "./dist/esm/v4.js",
      "module": "./dist/esm/v4.js",
      "import": "./dist/esm/v4.js",
      "require": "./dist/cjs/v4.js",
      "default": "./dist/esm/v4.js"
    },
    "./v5": {
      "types": "./types/v5.d.ts",
      "react-native": "./dist/esm/v5.js",
      "browser": "./dist/esm/v5.js",
      "module": "./dist/esm/v5.js",
      "import": "./dist/esm/v5.js",
      "require": "./dist/cjs/v5.js",
      "default": "./dist/esm/v5.js"
    },
    "./v5-subtle": {
      "types": "./types/v5-subtle.d.ts",
      "react-native": "./dist/esm/v5-subtle.js",
      "browser": "./dist/esm/v5-subtle.js",
      "module": "./dist/esm/v5-subtle.js",
      "import": "./dist/esm/v5-subtle.js",
      "require": "./dist/cjs/v5-subtle.js",
      "default": "./dist/esm/v5-subtle.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "bun run generate:v5 & bun run generate:v5-subtle",
    "generate:v5": "hanzogui generate-themes ./src/v5-themes.ts ./src/generated-v5.ts",
    "generate:v5-subtle": "hanzogui generate-themes ./src/v5-themes-subtle.ts ./src/generated-v5-subtle.ts",
    "generate:new": "hanzogui generate-themes ./src/themes-new.ts ./src/generated-new.ts",
    "generate:v3": "hanzogui generate-themes ./src/v3-themes.ts ./src/generated-v3.ts",
    "generate:v4": "hanzogui generate-themes ./src/v4-default.ts ./src/generated-v4.ts",
    "generate:v4-hanzogui": "hanzogui generate-themes ./src/v4-hanzogui.ts ./src/generated-v4-hanzogui.ts",
    "test": "bun run generate",
    "build": "hanzogui-build --skip-native",
    "watch": "hanzogui-build --watch",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build"
  },
  "dependencies": {
    "@hanzogui/colors": "workspace:*",
    "@hanzogui/create-theme": "workspace:*",
    "@hanzogui/theme-builder": "workspace:*",
    "@hanzogui/web": "workspace:*",
    "color2k": "^2.0.4"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*",
    "@hanzogui/cli": "workspace:*",
    "vitest": "^4.1.11"
  }
}
