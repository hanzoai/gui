{
  "name": "@hanzogui/web",
  "version": "8.3.2",
  "license": "MIT",
  "author": {
    "name": "Nate Wienert"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoai/gui.git",
    "directory": "packages/web"
  },
  "source": "src/index.ts",
  "files": [
    "dist",
    "reset.css",
    "src",
    "types"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./reset.css": "./reset.css",
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/native/index.js",
      "browser": "./dist/esm/index.js",
      "module": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./types": {
      "types": "./types/index.d.ts"
    },
    "./types/*": {
      "types": "./types/*.d.ts"
    },
    "./inject-styles": {
      "types": "./types/inject-styles.d.ts",
      "react-native": "./dist/native/inject-styles.js",
      "browser": "./dist/esm/inject-styles.js",
      "module": "./dist/esm/inject-styles.js",
      "import": "./dist/esm/inject-styles.js",
      "require": "./dist/cjs/inject-styles.js",
      "default": "./dist/esm/inject-styles.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "hanzogui-build",
    "watch": "hanzogui-build --watch",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build",
    "test:web": "vitest --typecheck --run"
  },
  "dependencies": {
    "@hanzogui/compose-refs": "workspace:*",
    "@hanzogui/constants": "workspace:*",
    "@hanzogui/helpers": "workspace:*",
    "@hanzogui/is-equal-shallow": "workspace:*",
    "@hanzogui/native": "workspace:*",
    "@hanzogui/normalize-css-color": "workspace:*",
    "@hanzogui/timer": "workspace:*",
    "@hanzogui/types": "workspace:*",
    "@hanzogui/use-did-finish-ssr": "workspace:*",
    "@hanzogui/use-event": "workspace:*",
    "@hanzogui/use-force-update": "workspace:*"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "csstype": "^3.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "^0.87.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": ">=19.2.8",
    "react-dom": ">=19.2.8"
  }
}
