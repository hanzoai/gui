{
  "name": "@hanzogui/tauri",
  "version": "8.3.1",
  "description": "Tauri desktop adapter for Hanzo GUI \u2014 window controls, global shortcuts, fs/shell bridge so hanzogui components run in a Tauri webview.",
  "files": [
    "src",
    "types",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/esm/index.js",
      "browser": "./dist/esm/index.js",
      "module": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "hanzogui-build --skip-native",
    "watch": "hanzogui-build --skip-types --watch",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-shell": "^2.3.5"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*",
    "@hanzo/gui": "workspace:*",
    "react": "19.2.8"
  },
  "peerDependencies": {
    "@hanzo/gui": ">=8.3.1",
    "react": ">=19.2.8"
  },
  "license": "BSD-3-Clause",
  "author": "Hanzo AI <dev@hanzo.ai>"
}
