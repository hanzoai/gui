{
  "extends": "../../tsconfig",
  "compilerOptions": {
    // `tsconfig.build.json` REFERENCES this project, and `tsc -b` decides a
    // referenced project is up to date by looking for the outputs its options
    // describe. `noEmit: true` under the root's `outDir` promised outputs that
    // could never appear, so this project was permanently out of date and every
    // typecheck re-checked all ~4k files instead of caching — the whole reason
    // the type-performance benchmark reported a 6.5x slowdown.
    //
    // `composite` is what a referenced project is supposed to be, and it is what
    // the sibling `apps/demos` already uses.
    "composite": true
  },
  "exclude": ["e2e"],
  "references": [
    {
      "path": "../../pkgs/compiler/babel-plugin"
    },
    {
      "path": "../../pkgs/core/cli"
    },
    {
      "path": "../../pkgs/core/colors"
    },
    {
      "path": "../../pkgs/core/config"
    },
    {
      "path": "../../pkgs/core/core"
    },
    {
      "path": "../../pkgs/core/shorthands"
    },
    {
      "path": "../../pkgs/core/themes"
    },
    {
      "path": "../../pkgs/core/web"
    },
    {
      "path": "../demos"
    },
    {
      "path": "../../pkgs/lucide-icons"
    },
    {
      "path": "../../pkgs/ui/toast"
    }
  ]
}
