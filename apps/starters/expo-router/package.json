    "burnt": "^0.13.0",
    "expo": "^57.0.18",
    "expo-build-properties": "^57.0.15",
    "expo-font": "^57.0.2",
    "expo-linking": "^57.0.8",
    "expo-router": "^57.0.17",
    "expo-splash-screen": "^57.0.8",
    "expo-status-bar": "^57.0.1",
    "expo-system-ui": "^57.0.3",
    "expo-web-browser": "^57.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "^0.87.1",
    "react-native-reanimated": "^4.6.0",
