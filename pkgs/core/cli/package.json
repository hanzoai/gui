{
  "name": "@hanzogui/cli",
  "version": "8.3.1",
  "bin": {
    "tama": "dist/esm/cli.js",
    "hanzogui": "dist/esm/cli.js"
  },
  "source": "src/index.ts",
  "files": [
    "src",
    "types",
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/esm/index.js",
  "types": "./types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "hanzogui-build --skip-native",
    "watch": "bun run build --skip-native --watch",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build",
    "test": "vitest run",
    "test:web": "bun run test"
  },
  "dependencies": {
    "@hanzogui/create-theme": "workspace:*",
    "@hanzogui/generate-themes": "workspace:*",
    "@hanzogui/static": "workspace:*",
    "@hanzogui/types": "workspace:*",
    "@hanzogui/vite-plugin": "workspace:*",
    "arg": "^5.0.2",
    "chalk": "^6.0.0",
    "change-case": "^5.4.4",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "fs-extra": "^11.4.0",
    "get-port": "^7.2.0",
    "marked": "^18.0.11",
    "marked-terminal": "^7.3.0",
    "micromatch": "^4.0.8",
    "opener": "^1.5.2",
    "prompts": "^2.4.2",
    "ts-morph": "^28.0.0",
    "typescript": "7.0.2",
    "url": "^0.11.4"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*",
    "@types/chokidar": "^2.1.7",
    "@types/marked": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "module": "dist/esm/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  }
}
