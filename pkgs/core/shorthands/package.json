{
  "name": "@hanzogui/shorthands",
  "version": "8.3.1",
  "gitHead": "a49cc7ea6b93ba384e77a4880ae48ac4a5635c14",
  "source": "src/index.ts",
  "files": [
    "dist",
    "src",
    "types",
    "v4",
    "v5"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/esm/index.js",
      "browser": "./dist/esm/index.js",
      "module": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./v4": {
      "types": "./types/v4.d.ts",
      "react-native": "./dist/esm/v4.js",
      "browser": "./dist/esm/v4.js",
      "module": "./dist/esm/v4.js",
      "import": "./dist/esm/v4.js",
      "require": "./dist/cjs/v4.js",
      "default": "./dist/esm/v4.js"
    },
    "./v5": {
      "types": "./types/v5.d.ts",
      "react-native": "./dist/esm/v5.js",
      "browser": "./dist/esm/v5.js",
      "module": "./dist/esm/v5.js",
      "import": "./dist/esm/v5.js",
      "require": "./dist/cjs/v5.js",
      "default": "./dist/esm/v5.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "hanzogui-build --skip-native",
    "watch": "hanzogui-build --watch",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build"
  },
  "dependencies": {
    "@hanzogui/web": "workspace:*"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*"
  }
}
