{
  "name": "@hanzogui/proxy-worm",
  "version": "8.3.2",
  "gitHead": "a49cc7ea6b93ba384e77a4880ae48ac4a5635c14",
  "files": [
    "src",
    "types",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/esm/index.js",
      "browser": "./dist/esm/index.js",
      "module": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./empty-react-native-view": {
      "types": "./types/empty-react-native-view.d.ts",
      "react-native": "./dist/esm/empty-react-native-view.js",
      "browser": "./dist/esm/empty-react-native-view.js",
      "module": "./dist/esm/empty-react-native-view.js",
      "import": "./dist/esm/empty-react-native-view.js",
      "require": "./dist/cjs/empty-react-native-view.js",
      "default": "./dist/esm/empty-react-native-view.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "hanzogui-build --skip-native",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*"
  }
}
