{
  "name": "@hanzogui/logo",
  "version": "8.3.1",
  "source": "src/index.tsx",
  "files": [
    "src",
    "types",
    "dist",
    "*.cjs"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/esm/index.js",
      "browser": "./dist/esm/index.js",
      "module": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./icon": {
      "types": "./types/LogoIcon.d.ts",
      "react-native": "./dist/esm/LogoIcon.js",
      "browser": "./dist/esm/LogoIcon.js",
      "module": "./dist/esm/LogoIcon.js",
      "import": "./dist/esm/LogoIcon.js",
      "require": "./dist/cjs/LogoIcon.js",
      "default": "./dist/esm/LogoIcon.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "hanzogui-build --skip-native",
    "watch": "hanzogui-build --watch",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build"
  },
  "dependencies": {
    "@hanzo/gui": "workspace:*",
    "@hanzo/logo": "^1.0.26",
    "@hanzogui/use-element-layout": "workspace:*",
    "@hanzogui/web": "workspace:*"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*",
    "react": "19.2.8"
  },
  "peerDependencies": {
    "react": ">=19.2.8"
  }
}
