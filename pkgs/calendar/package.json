{
  "name": "@hanzo/calendar",
  "version": "0.1.0",
  "description": "Universal (web + native) scheduling UI for the Hanzo Calendar — a Booker, Confirmation, and compact CalendarEmbed built with hanzogui primitives.",
  "license": "BSD-3-Clause",
  "author": "Hanzo AI <dev@hanzo.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/gui.git",
    "directory": "pkgs/calendar"
  },
  "source": "src/index.ts",
  "type": "module",
  "sideEffects": false,
  "main": "dist/cjs",
  "module": "dist/esm",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/esm/index.native.js",
      "browser": "./dist/esm/index.mjs",
      "module": "./dist/esm/index.mjs",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.mjs"
    }
  },
  "files": [
    "src",
    "types",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "gui-build",
    "watch": "gui-build --watch",
    "clean": "gui-build clean",
    "clean:build": "gui-build clean:build"
  },
  "peerDependencies": {
    "hanzogui": ">=7.0.0",
    "react": ">=18",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*",
    "hanzogui": "workspace:*",
    "react": ">=19",
    "react-native": "0.83.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
