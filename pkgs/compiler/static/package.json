    "@babel/types": "^8.0.4",
    "@hanzogui/cli-color": "workspace:*",
    "@hanzogui/config-default": "workspace:*",
    "@hanzogui/core": "workspace:*",
    "@hanzogui/fake-react-native": "workspace:*",
    "@hanzogui/generate-themes": "workspace:*",
    "@hanzogui/helpers": "workspace:*",
    "@hanzogui/helpers-node": "workspace:*",
    "@hanzogui/proxy-worm": "workspace:*",
    "@hanzogui/react-native-web-internals": "workspace:*",
    "@hanzogui/react-native-web-lite": "workspace:*",
    "@hanzogui/shorthands": "workspace:*",
    "@hanzogui/types": "workspace:*",
    "@hanzogui/web": "workspace:*",
    "babel-literal-to-ast": "^2.1.0",
    "browserslist": "^4.28.8",
    "check-dependency-version-consistency": "^6.0.0",
