{
  "name": "@hanzogui/static-sync",
  "version": "8.3.1",
  "license": "MIT",
  "source": "src/index.ts",
  "files": [
    "src",
    "types",
    "dist"
  ],
  "type": "commonjs",
  "main": "dist",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "browser": "./dist/index.cjs",
      "module": "./dist/index.cjs",
      "import": "./dist/index.cjs",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.cjs --format cjs --target node --packages external",
    "watch": "bun run build --watch",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@hanzogui/static": "workspace:*",
    "@hanzogui/types": "workspace:*",
    "synckit": "^0.11.13"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*"
  }
}
