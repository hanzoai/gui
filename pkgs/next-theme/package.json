{
  "name": "@hanzogui/next-theme",
  "version": "7.3.0",
  "source": "src/index.ts",
  "files": [
    "src",
    "types",
    "dist"
  ],
  "type": "module",
  "main": "dist/cjs",
  "module": "dist/esm",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "browser": "./dist/esm/index.mjs",
      "module": "./dist/esm/index.mjs",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/cjs/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "gui-build --skip-native",
    "watch": "gui-build --skip-native --watch",
    "clean": "gui-build clean",
    "clean:build": "gui-build clean:build"
  },
  "dependencies": {
    "@hanzogui/constants": "workspace:*",
    "@hanzogui/use-event": "workspace:*"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*",
    "next": "16.1.1",
    "react": ">=19"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=19"
  },
  "license": "BSD-3-Clause",
  "author": "Hanzo AI <dev@hanzo.ai>"
}
