  "scripts": {
    "test:web": "DISABLE_REACT_NATIVE=1 TEST_ENVIRONMENT=jsdom GUI_TARGET=web vitest --run --config ../../packages/vite-plugin-internal/src/vite.config.ts *.web.test.tsx",
