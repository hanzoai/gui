{
  "name": "@hanzogui/static",
  "version": "8.3.1",
  "gitHead": "a49cc7ea6b93ba384e77a4880ae48ac4a5635c14",
  "license": "MIT",
  "source": "src/index.ts",
  "files": [
    "src",
    "types",
    "dist"
  ],
  "type": "commonjs",
  "main": "dist",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.cjs"
    },
    "./worker": {
      "types": "./types/worker.d.ts",
      "default": "./dist/worker.cjs"
    },
    "./extractablePath": {
      "types": "./types/extractor/extractablePath.d.ts",
      "default": "./dist/extractor/extractablePath.cjs"
    },
    "./checkDeps": {
      "types": "./types/checkDeps.d.ts",
      "default": "./dist/checkDeps.cjs"
    },
    "./loadGui": {
      "types": "./types/extractor/loadGui.d.ts",
      "default": "./dist/extractor/loadGui.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "hanzogui-build --skip-native",
    "watch": "hanzogui-build --skip-native --watch",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/generator": "^8.0.0",
    "@babel/helper-plugin-utils": "^8.0.1",
    "@babel/parser": "^8.0.4",
