{
  "name": "bento-get",
  "version": "8.3.1",
  "license": "MIT",
  "_comment_private": "npm's `bento-get` belongs to upstream (nwienert), not us \u2014 publishing it returns 403. The name survived the rebrand because it carries no `tamagui` string to rewrite, so it is the one publishable package here we do not own. It stays in the tree to keep merges with upstream clean, and is private so the release never reaches for it.",
  "private": true,
  "bin": {
    "bento-get": "dist/cli.js"
  },
  "source": "src/cli.tsx",
  "files": [
    "source",
    "types",
    "dist"
  ],
  "type": "module",
  "module": "dist",
  "types": "./types/cli.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/esm/index.native.js",
      "browser": "./dist/esm/index.mjs",
      "module": "./dist/esm/index.mjs",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "hanzogui-build --skip-types",
    "watch": "bun run build --watch",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build",
    "local-npm-link": "npm link --local --force"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@supabase/supabase-js": "^2.112.4",
    "conf": "^15.1.0",
    "copy-paste": "^2.2.0",
    "file-paths-to-tree": "^4.0.0",
    "fuse.js": "^7.5.0",
    "ink": "^7.1.1",
    "ink-link": "^5.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "node-fetch": "^3.3.2",
    "octokit": "^5.0.5",
    "open": "^11.0.2",
    "pastel": "^4.0.1",
    "react": "19.2.8",
    "react-router-dom": "^7.18.3",
    "swr": "^2.5.1",
    "type-fest": "^5.8.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*",
    "@types/copy-paste": "^2.1.0",
    "@types/ink": "^2.0.3",
    "@types/react": "19.2.18"
  },
  "engines": {
    "node": ">=20"
  }
}
