{
  "name": "@hanzogui/shell",
  "version": "8.3.9",
  "description": "Unified Hanzo shell \u2014 HanzoHeader (the one public bar: Hanzo mega-menu, \u2318K search, the canonical CTA pill, IAM identity), OrgHeader (the signed-in bar), UserOrgDropdown (the one org switcher), Masquerade, AskHanzo (the visitor chat), MeetHanzoMenu, ProductsMegaMenu, HanzoFooter, HanzoPreFooterCTA, HanzoAppLauncher + the canonical surface registry",
  "source": "src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/hanzo-registry.d.ts",
      "import": "./dist/hanzo-registry.js",
      "default": "./dist/hanzo-registry.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test *.test.mjs",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=19.2.8",
    "react-dom": ">=19.2.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/gui",
    "directory": "pkgs/ui/shell"
  },
  "source": "src/index.ts",
  "files": [
    "dist",
    "src",
    "types"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/esm/index.js",
      "browser": "./dist/esm/index.js",
      "module": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./registry": {
      "types": "./types/hanzo-registry.d.ts",
      "react-native": "./dist/esm/hanzo-registry.js",
      "browser": "./dist/esm/hanzo-registry.js",
      "module": "./dist/esm/hanzo-registry.js",
      "import": "./dist/esm/hanzo-registry.js",
      "require": "./dist/cjs/hanzo-registry.js",
      "default": "./dist/esm/hanzo-registry.js"
    },
    "./theme": {
      "types": "./types/theme.d.ts",
      "react-native": "./dist/esm/theme.js",
      "browser": "./dist/esm/theme.js",
      "module": "./dist/esm/theme.js",
      "import": "./dist/esm/theme.js",
      "require": "./dist/cjs/theme.js",
      "default": "./dist/esm/theme.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "hanzogui-build --skip-native",
    "test": "bun run build && node --test *.test.mjs",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.2.8",
    "react-dom": ">=19.2.8"
  }
}
