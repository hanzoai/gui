{
  "name": "@hanzogui/dev-config",
  "version": "8.3.1",
  "source": "src/index.ts",
  "files": [
    "src",
    "types",
    "dist",
    "motion.cjs"
  ],
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "browser": "./dist/esm/index.js",
      "module": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./motion": {
      "types": "./types/animations.motion.d.ts",
      "browser": "./dist/esm/animations.motion.js",
      "module": "./dist/esm/animations.motion.js",
      "import": "./dist/esm/animations.motion.js",
      "require": "./dist/cjs/animations.motion.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "hanzogui-build --skip-native",
    "watch": "hanzogui-build --skip-types --skip-native --watch",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build"
  },
  "dependencies": {
    "@hanzogui/animations-css": "workspace:*",
    "@hanzogui/animations-moti": "workspace:*",
    "@hanzogui/animations-motion": "workspace:*",
    "@hanzogui/animations-reanimated": "workspace:*",
    "@hanzogui/colors": "workspace:*",
    "@hanzogui/config": "workspace:*",
    "@hanzogui/core": "workspace:*",
    "@hanzogui/font-zen": "workspace:*",
    "@hanzogui/shorthands": "workspace:*",
    "@hanzogui/theme-builder": "workspace:*",
    "@hanzogui/themes": "workspace:*",
    "color2k": "^2.0.4"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*",
    "react": "19.2.8"
  },
  "peerDependencies": {
    "react": ">=19.2.8"
  }
}
