{
  "name": "@hanzogui/chrome",
  "version": "8.3.1",
  "description": "Marketing sections for Hanzo public sites — HanzoFooter, ChatHero, HanzoWidget. The site HEADER lives in @hanzogui/shell (HanzoHeader); this package no longer ships a nav.",
  "license": "BSD-3-Clause",
  "author": "Hanzo AI <dev@hanzo.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/gui",
    "directory": "pkgs/ui/chrome"
  },
  "source": "src/index.ts",
  "files": [
    "src",
    "types",
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/esm/index.js",
      "browser": "./dist/esm/index.js",
      "module": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "hanzogui-build --skip-native",
    "watch": "hanzogui-build --watch",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build"
  },
  "dependencies": {
    "@hanzogui/core": "workspace:*",
    "@hanzogui/font-zen": "workspace:*",
    "@hanzogui/input": "workspace:*",
    "@hanzogui/lucide-icons-2": "workspace:*",
    "@hanzogui/stacks": "workspace:*",
    "@hanzogui/web": "workspace:*"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*",
    "react": "19.2.8"
  },
  "peerDependencies": {
    "react": ">=19.2.8"
  },
  "module:jsx": "dist/jsx"
}
