{
  "name": "@hanzogui/remix-starter",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build:web": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "prod": "bun run build:web && bun run start",
    "upgrade:hanzogui": "bunx npm-check-updates -u '*hanzogui*' '@hanzogui/*' && bun install"
  },
  "dependencies": {
    "@hanzo/font": "1.9.2",
    "@hanzo/gui": "workspace:*",
    "@hanzogui/config": "workspace:*",
    "@react-router/node": "^7.15.1",
    "@react-router/serve": "^7.15.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^7.15.1"
  },
  "devDependencies": {
    "@react-router/dev": "^7.15.1",
    "@react-router/fs-routes": "^8.3.1",
    "@hanzogui/vite-plugin": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.9",
  "version": "8.3.1"
}
