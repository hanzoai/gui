  "source": "src/index.ts",
  "files": [
    "src",
    "types",
    "dist"
  ],
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./reset.css": "./reset.css",
    ".": {
      "types": "./types/index.d.ts",
      "browser": "./dist/esm/index.js",
      "module": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "hanzogui-build --skip-native",
    "watch": "hanzogui-build --skip-native --watch",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build"
  },
  "dependencies": {
    "@babel/preset-react": "^8.0.1",
    "@hanzogui/loader": "workspace:*",
    "@hanzogui/proxy-worm": "workspace:*",
    "@hanzogui/react-native-svg": "workspace:*",
    "@hanzogui/static": "workspace:*",
    "babel-loader": "^10.1.1",
    "browserslist": "^4.28.8",
    "css-loader": "^7.1.5",
    "esbuild-loader": "^4.5.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.8",
    "url-loader": "^4.1.1"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*",
    "next": "16.3.3",
    "webpack": "^5.110.1"
