{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": false,
    "incremental": false,
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    "inlineSourceMap": false,
    "paths": {},
    "module": "commonjs",
    "moduleResolution": "bundler",
    "outDir": "dist/cjs",
    "declaration": true,
    "declarationMap": false,
    "declarationDir": "dist/cjs/.types"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.*", "src/**/__tests__/**", "src/**/*.stories.*"]
}
