{
  "name": "@hanzogui/get",
  "version": "8.3.1",
  "description": "CLI installer for Hanzo GUI recipes.",
  "homepage": "https://gui.hanzo.ai",
  "license": "BSD-3-Clause",
  "author": "Hanzo AI <dev@hanzo.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/gui.git",
    "directory": "pkgs/get"
  },
  "bin": {
    "hanzo-gui-get": "./dist/cli.js"
  },
  "source": "src/cli.ts",
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "dist"
  ],
  "type": "module",
  "main": "./dist/cli.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build.ts",
    "clean": "rm -rf dist",
    "test": "bun test"
  },
  "dependencies": {
    "@hanzogui/recipes": "workspace:*",
    "fuse.js": "^7.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
