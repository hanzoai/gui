{
  "name": "@hanzogui/kitchen-sink",
  "version": "8.3.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start:one": "one dev",
    "start:web": "DISABLE_EXTRACTION=true NODE_ENV=development webpack serve",
    "start:web:prod": "NODE_ENV=production webpack serve",
    "start:web:extract": "DISABLE_EXTRACTION=false NODE_ENV=development webpack serve",
    "start": "EXPO_NO_TELEMETRY=true expo start --dev-client --offline",
    "start:extract": "GUI_OPTIMIZE_NATIVE_VIEWS=1 GUI_ENABLE_DYNAMIC_LOAD=1 bun run start",
    "start:prod": "DISABLE_EXTRACTION=false GUI_ENABLE_DYNAMIC_LOAD=1 expo start --dev-client --offline --no-dev --minify",
    "start:hanzogui": "tama dev",
    "start:android": "bun run start --android",
    "start:ios": "bun run start --ios",
    "start:clean": "watchman watch-del-all & rm -r $TMPDIR/metro-cache & bun run start -c",
    "pod": "./pod-install.sh",
    "android": "EXPO_NO_TELEMETRY=true expo run:android",
    "ios": "bun run pod && EXPO_NO_TELEMETRY=true expo run:ios",
    "ios:prod": "bun run ios --configuration Release",
    "eject": "EXPO_NO_TELEMETRY=true expo eject",
    "screenshot": "node -r esbuild-register ../../node_modules/.bin/playwright test --config ./playwright-screenshot.config.ts",
    "test:native:ios": "bun run ../../pkgs/native-ci/src/cli.ts test ios --project-root .",
    "test:native:android": "bun run ../../pkgs/native-ci/src/cli.ts test android --project-root .",
    "test:native:maestro": "bun run ../../pkgs/native-ci/src/cli.ts test maestro --project-root .",
    "test:web": "bun run-tests-parallel.ts",
    "test:web:seq": "NODE_ENV=test node -r esbuild-register ../../node_modules/.bin/playwright test",
    "test:web:driver": "NODE_ENV=test node -r esbuild-register ../../node_modules/.bin/playwright test",
    "test:web:debug": "NODE_ENV=test node -r esbuild-register ../../node_modules/.bin/playwright test --debug",
    "detox:build:ios": "bun run pod && detox build -c ios.sim.debug",
    "detox:build:android": "detox build -c android.emu.debug",
    "detox:run:ios": "./run-detox.sh ios",
    "detox:run:android": "./run-detox.sh android",
    "prod:web": "NODE_ENV=production webpack --json=dist/compilation-stats.json",
    "test:native": "bun run test:native:ios && bun run test:native:maestro",
    "test": "bun run test:web && ./run-native-tests.sh"
  },
  "dependencies": {
    "@dominicstop/ts-event-emitter": "^1.1.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-menu/menu": "^2.0.0",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@shopify/restyle": "^2.4.5",
    "@hanzogui/animate-presence": "workspace:*",
    "@hanzogui/animations-css": "workspace:*",
    "@hanzogui/animations-motion": "workspace:*",
    "@hanzogui/animations-react-native": "workspace:*",
    "@hanzogui/animations-reanimated": "workspace:*",
    "@hanzogui/colors": "workspace:*",
    "@hanzogui/config": "workspace:*",
    "@hanzogui/constants": "workspace:*",
    "@hanzogui/core": "workspace:*",
    "@hanzogui/demos": "workspace:*",
    "@hanzogui/get-token": "workspace:*",
    "@hanzogui/input": "workspace:*",
    "@hanzogui/lucide-icons-2": "workspace:*",
    "@hanzogui/menu": "workspace:*",
    "@hanzogui/native": "workspace:*",
    "@hanzogui/portal": "workspace:*",
    "@hanzogui/sandbox-ui": "workspace:*",
    "@hanzogui/scroll-view": "workspace:*",
    "@hanzogui/sheet": "workspace:*",
    "@hanzogui/shorthands": "workspace:*",
    "@hanzogui/theme": "workspace:*",
    "@hanzogui/themes": "workspace:*",
    "@hanzogui/toast": "workspace:*",
    "@hanzogui/web": "workspace:*",
    "burnt": "^0.13.0",
    "expo": "^57.0.18",
    "expo-constants": "^57.0.16",
    "expo-document-picker": "^57.0.1",
    "expo-font": "^57.0.2",
    "expo-image-picker": "^57.0.14",
    "expo-linear-gradient": "^57.0.1",
    "expo-linking": "^57.0.8",
    "expo-splash-screen": "^57.0.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "^0.87.1",
    "react-native-actions-sheet": "^10.1.2",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-ios-context-menu": "^3.2.1",
    "react-native-ios-utilities": "^5.2.0",
    "react-native-keyboard-controller": "^1.22.4",
    "react-native-launch-arguments": "^4.1.1",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-svg": "^15.15.5",
    "react-native-teleport": "^1.2.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.12.1",
    "sf-symbols-typescript": "^2.2.0",
    "solito": "^5.0.0",
    "@hanzo/font": "^1.9.3",
    "@hanzo/gui": "workspace:*",
    "vitest": "^4.1.11",
    "zeego": "^3.0.6"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@expo/fingerprint": "^0.20.11",
    "@playwright/test": "^1.62.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@hanzogui/babel-plugin": "workspace:*",
    "@hanzogui/metro-plugin": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/pngjs": "^6.0.5",
    "babel-plugin-module-resolver": "^5.0.3",
    "detox": "^20.51.4",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.0",
    "mini-css-extract-plugin": "^2.10.2",
    "one": "^1.25.8",
    "pngjs": "^7.0.0",
    "pod-install": "^1.1.0",
    "tilg": "^0.1.1",
    "ts-jest": "^29.4.12",
    "webpack": "^5.110.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "packageManager": "bun@1.3.9"
}
