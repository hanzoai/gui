{
  "name": "@hanzogui/remix-starter",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build:web": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "prod": "bun run build:web && bun run start",
    "upgrade:hanzogui": "bunx npm-check-updates -u '*hanzogui*' '@hanzogui/*' && bun install"
  },
  "dependencies": {
    "@hanzo/font": "^1.9.1",
    "@hanzo/gui": "workspace:*",
    "@hanzogui/config": "workspace:*",
    "@react-router/node": "^7.18.0",
    "@react-router/serve": "^7.18.0",
    "react": ">=19",
    "react-dom": ">=19",
    "react-router": "^7.18.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.0",
    "@react-router/fs-routes": "^7.18.0",
    "@hanzogui/vite-plugin": "workspace:*",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "typescript": "~5.9.2",
    "vite": "^8.0.3",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.9",
  "version": "8.3.0"
}
