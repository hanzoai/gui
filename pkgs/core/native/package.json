{
  "name": "@hanzogui/native",
  "version": "8.3.2",
  "description": "Native setup modules for Gui - portals, gesture handler, worklets, and more",
  "files": [
    "dist",
    "src",
    "types"
  ],
  "type": "module",
  "sideEffects": [
    "**/setup-*",
    "**/gesture-handler*"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./types/index.d.ts",
  "typesVersions": {
    "*": {
      "setup-teleport": [
        "./types/setup-teleport.d.ts"
      ],
      "setup-gesture-handler": [
        "./types/setup-gesture-handler.d.ts"
      ],
      "gesture-handler": [
        "./types/gesture-handler.d.ts"
      ],
      "setup-worklets": [
        "./types/setup-worklets.d.ts"
      ],
      "setup-safe-area": [
        "./types/setup-safe-area.d.ts"
      ],
      "setup-expo-linear-gradient": [
        "./types/setup-expo-linear-gradient.d.ts"
      ],
      "setup-keyboard-controller": [
        "./types/setup-keyboard-controller.d.ts"
      ],
      "setup-zeego": [
        "./types/setup-zeego.d.ts"
      ],
      "setup-burnt": [
        "./types/setup-burnt.d.ts"
      ]
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/esm/index.js",
      "browser": "./dist/esm/index.js",
      "module": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./setup-teleport": {
      "types": "./types/setup-teleport.d.ts",
      "react-native": "./dist/esm/setup-teleport.js",
      "browser": "./dist/esm/setup-teleport.js",
      "module": "./dist/esm/setup-teleport.js",
      "import": "./dist/esm/setup-teleport.js",
      "require": "./dist/cjs/setup-teleport.js",
      "default": "./dist/esm/setup-teleport.js"
    },
    "./setup-gesture-handler": {
      "types": "./types/setup-gesture-handler.d.ts",
      "react-native": "./dist/esm/setup-gesture-handler.js",
      "browser": "./dist/esm/setup-gesture-handler.js",
      "module": "./dist/esm/setup-gesture-handler.js",
      "import": "./dist/esm/setup-gesture-handler.js",
      "require": "./dist/cjs/setup-gesture-handler.js",
      "default": "./dist/esm/setup-gesture-handler.js"
    },
    "./gesture-handler": {
      "types": "./types/gesture-handler.d.ts",
      "react-native": "./dist/esm/gesture-handler.js",
      "browser": "./dist/esm/gesture-handler.js",
      "module": "./dist/esm/gesture-handler.js",
      "import": "./dist/esm/gesture-handler.js",
      "require": "./dist/cjs/gesture-handler.js",
      "default": "./dist/esm/gesture-handler.js"
    },
    "./setup-worklets": {
      "types": "./types/setup-worklets.d.ts",
      "react-native": "./dist/esm/setup-worklets.js",
      "browser": "./dist/esm/setup-worklets.js",
      "module": "./dist/esm/setup-worklets.js",
      "import": "./dist/esm/setup-worklets.js",
      "require": "./dist/cjs/setup-worklets.js",
      "default": "./dist/esm/setup-worklets.js"
    },
    "./setup-safe-area": {
      "types": "./types/setup-safe-area.d.ts",
      "react-native": "./dist/esm/setup-safe-area.js",
      "browser": "./dist/esm/setup-safe-area.js",
      "module": "./dist/esm/setup-safe-area.js",
      "import": "./dist/esm/setup-safe-area.js",
      "require": "./dist/cjs/setup-safe-area.js",
      "default": "./dist/esm/setup-safe-area.js"
    },
    "./setup-expo-linear-gradient": {
      "types": "./types/setup-expo-linear-gradient.d.ts",
      "react-native": "./dist/esm/setup-expo-linear-gradient.js",
      "browser": "./dist/esm/setup-expo-linear-gradient.js",
      "module": "./dist/esm/setup-expo-linear-gradient.js",
      "import": "./dist/esm/setup-expo-linear-gradient.js",
      "require": "./dist/cjs/setup-expo-linear-gradient.js",
      "default": "./dist/esm/setup-expo-linear-gradient.js"
    },
    "./setup-keyboard-controller": {
      "types": "./types/setup-keyboard-controller.d.ts",
      "react-native": "./dist/esm/setup-keyboard-controller.js",
      "browser": "./dist/esm/setup-keyboard-controller.js",
      "module": "./dist/esm/setup-keyboard-controller.js",
      "import": "./dist/esm/setup-keyboard-controller.js",
      "require": "./dist/cjs/setup-keyboard-controller.js",
      "default": "./dist/esm/setup-keyboard-controller.js"
    },
    "./setup-zeego": {
      "types": "./types/setup-zeego.d.ts",
      "react-native": "./dist/esm/setup-zeego.js",
      "browser": "./dist/esm/setup-zeego.js",
      "module": "./dist/esm/setup-zeego.js",
      "import": "./dist/esm/setup-zeego.js",
      "require": "./dist/cjs/setup-zeego.js",
      "default": "./dist/esm/setup-zeego.js"
    },
    "./setup-burnt": {
      "types": "./types/setup-burnt.d.ts",
      "react-native": "./dist/esm/setup-burnt.js",
      "browser": "./dist/esm/setup-burnt.js",
      "module": "./dist/esm/setup-burnt.js",
      "import": "./dist/esm/setup-burnt.js",
      "require": "./dist/cjs/setup-burnt.js",
      "default": "./dist/esm/setup-burnt.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "hanzogui-build --skip-native",
    "watch": "hanzogui-build --watch",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*",
    "burnt": "^0.13.0",
    "react": "19.2.8",
    "react-native": "^0.87.1",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-keyboard-controller": "^1.22.4",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-teleport": "^1.2.0",
    "react-native-worklets-core": "^1.6.3",
    "zeego": "^3.0.6"
  },
  "peerDependencies": {
    "react": ">=19.2.8"
  }
}
