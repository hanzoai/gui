{
  "name": "@hanzogui/dismissable",
  "version": "7.3.0",
  "source": "src/index.ts",
  "files": [
    "src",
    "types",
    "dist"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "dist/cjs",
  "module": "dist/esm",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/esm/index.native.js",
      "browser": "./dist/esm/index.mjs",
      "module": "./dist/esm/index.mjs",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "gui-build",
    "watch": "gui-build --watch",
    "clean": "gui-build clean",
    "clean:build": "gui-build clean:build"
  },
  "dependencies": {
    "@hanzogui/compose-refs": "workspace:*",
    "@hanzogui/core": "workspace:*",
    "@hanzogui/helpers": "workspace:*",
    "@hanzogui/use-escape-keydown": "workspace:*",
    "@hanzogui/use-event": "workspace:*"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*",
    "react": ">=19",
    "react-dom": "*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": "*"
  },
  "module:jsx": "dist/jsx",
  "license": "BSD-3-Clause",
  "author": "Hanzo AI <dev@hanzo.ai>"
}
