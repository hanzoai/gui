{
  "name": "create-gui",
  "version": "8.3.1",
  "gitHead": "a49cc7ea6b93ba384e77a4880ae48ac4a5635c14",
  "bin": {
    "create-gui": "run.js"
  },
  "files": [
    "run.js",
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.cjs",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "./run.js",
    "//": "disabling for now need to migrate to new stack",
    "test-disabled": "NODE_ENV=test node -r esbuild-register ../../../node_modules/.bin/playwright test integration.test.ts",
    "test:debug": "bun run test --debug",
    "test": "bun run build:test && vitest run",
    "test:web": "bun run test",
    "build:test": "bun run build",
    "prerelease": "rimraf ./dist/",
    "prepublish": "bun run build",
    "build": "bun build src/index.ts --outfile dist/index.cjs --format cjs --target node --packages external",
    "watch": "bun run build --watch",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build"
  },
  "dependencies": {
    "@expo/package-manager": "^1.13.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "detect-package-manager": "^3.0.2",
    "fs-extra": "^11.4.0",
    "opener": "^1.5.2",
    "prompts": "^2.4.2",
    "rimraf": "^6.1.3",
    "validate-npm-package-name": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@hanzogui/build": "workspace:*",
    "@types/node": "26.4.0",
    "@types/opener": "^1.4.3",
    "@types/prompts": "^2.4.9",
    "@types/rimraf": "^4.0.5",
    "@types/validate-npm-package-name": "^4.0.2",
    "esbuild-register": "^3.6.0",
    "tempy": "^3.2.0",
    "vitest": "^4.1.11"
  }
}
