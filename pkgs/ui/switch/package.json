{
  "name": "@hanzogui/switch",
  "version": "8.3.1",
  "source": "src/index.ts",
  "files": [
    "src",
    "types",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/native/index.js",
      "browser": "./dist/esm/index.js",
      "module": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "hanzogui-build",
    "watch": "hanzogui-build --watch",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build"
  },
  "dependencies": {
    "@hanzogui/compose-refs": "workspace:*",
    "@hanzogui/constants": "workspace:*",
    "@hanzogui/core": "workspace:*",
    "@hanzogui/focusable": "workspace:*",
    "@hanzogui/get-token": "workspace:*",
    "@hanzogui/helpers": "workspace:*",
    "@hanzogui/label": "workspace:*",
    "@hanzogui/stacks": "workspace:*",
    "@hanzogui/switch-headless": "workspace:*",
    "@hanzogui/use-controllable-state": "workspace:*",
    "@hanzogui/use-previous": "workspace:*",
    "@hanzogui/web": "workspace:*"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*",
    "react": "19.2.8",
    "react-native": "^0.87.1"
  },
  "peerDependencies": {
    "react": ">=19.2.8"
  },
  "module:jsx": "dist/jsx",
  "removeSideEffects": true
}
