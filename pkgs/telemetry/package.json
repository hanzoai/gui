{
  "name": "@hanzogui/telemetry",
  "version": "8.3.3",
  "description": "Zero-config Hanzo telemetry — one <TelemetryProvider/> wires errors + session capture, pageviews, and product events to the ONE endpoint (POST api.hanzo.ai/v1/event), which lenses them into sentry.hanzo.ai, analytics.hanzo.ai and insights.hanzo.ai. Honors DNT/GPC, consent-aware, SSR-safe, fail-soft.",
  "keywords": [
    "analytics",
    "consent",
    "error-tracking",
    "hanzo",
    "react",
    "session-replay",
    "telemetry"
  ],
  "license": "BSD-3-Clause",
  "author": "Hanzo AI <dev@hanzo.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/gui",
    "directory": "pkgs/telemetry"
  },
  "source": "src/index.ts",
  "files": [
    "src",
    "types",
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/esm/index.js",
      "browser": "./dist/esm/index.js",
      "module": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "hanzogui-build --skip-native",
    "watch": "hanzogui-build --watch",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hanzo/event": "^0.3.39",
    "@hanzo/observe": "^0.1.11"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "happy-dom": "^20.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": ">=19.2.8"
  }
}
