    "fast-glob": "^3.3.3",
    "find-cache-dir": "^6.0.0",
    "find-root": "^1.1.0",
    "fs-extra": "^11.4.0",
    "invariant": "^2.2.4",
    "js-yaml": "^5.4.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@hanzogui/build": "workspace:*",
    "@types/babel__core": "^7.20.5",
    "@types/find-root": "^1.1.4",
    "@types/node": "26.4.0",
    "@types/webpack": "^5.28.5",
    "babel-loader": "^10.1.1",
    "esbuild-loader": "^4.5.0",
    "null-loader": "^4.0.1",
    "react": "19.2.8",
    "react-native": "^0.87.1",
    "typescript": "7.0.2"
