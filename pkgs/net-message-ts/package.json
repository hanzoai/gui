{
  "name": "@hanzo_network/hanzo-message-ts",
  "version": "0.4.5",
  "description": "Hanzo Message TS wrapper for wasm library",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "typings": "src/index.d.ts",
  "keywords": [
    "hanzo",
    "hanzo-message",
    "hanzo-message wrapper"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/ed25519": "^2.0.0",
    "@noble/hashes": "^1.3.2",
    "@peculiar/webcrypto": "^1.7.1",
    "axios": "^1.6.8",
    "curve25519-js": "^0.0.4",
    "libsodium-wrappers-sumo": "^0.7.13"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./*": "./src/*"
  },
  "typesVersions": {
    "*": {
      ".": [
        "index.d.ts"
      ],
      "api": [
        "api.d.ts"
      ],
      "models": [
        "models.d.ts"
      ],
      "utils": [
        "utils.d.ts"
      ],
      "wasm": [
        "wasm.d.ts"
      ],
      "cryptography": [
        "cryptography.d.ts"
      ]
    }
  },
  "module": "./src/index.ts"
}
