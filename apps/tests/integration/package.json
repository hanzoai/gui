{
  "name": "integration",
  "version": "8.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "web": "bun run dev",
    "test": "node -r esbuild-register ../../../node_modules/.bin/playwright test simple.integration.test.js",
    "test:web": "bun run test",
    "build:prod": "vite build",
    "preview": "vite preview --host",
    "dev": "NODE_ENV=development vite --host --clearScreen false",
    "dev:extract": "EXTRACT=1 bun run dev",
    "prod": "NODE_ENV=production webpack --json=dist/compilation-stats.json"
  },
  "dependencies": {
    "@hanzo/gui": "workspace:*",
    "@hanzogui/animations-css": "workspace:*",
    "@hanzogui/core": "workspace:*",
    "@hanzogui/create-theme": "workspace:*",
    "@hanzogui/linear-gradient": "workspace:*",
    "@hanzogui/react-native-svg": "workspace:*",
    "@hanzogui/react-native-web-lite": "workspace:*",
    "@hanzogui/shorthands": "workspace:*"
  },
  "devDependencies": {
    "@hanzogui/vite-plugin": "workspace:*",
    "@playwright/test": "^1.62.1",
    "async-retry": "^1.3.3",
    "react-dom": "19.2.8",
    "vite": "^8.2.2",
    "wait-port": "^1.1.0"
  },
  "peerDependencies": {
    "react-dom": ">=19.2.8"
  }
}
