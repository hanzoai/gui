{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@hanzo/base-ui/*": ["../admin-base/src/*"]
    }
  },
  "include": ["App.tsx", "gui.config.ts", "index.js", "metro.config.js"]
}
