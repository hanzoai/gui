{
  "name": "@hanzogui/recipes",
  "version": "8.3.1",
  "description": "Hanzo GUI recipe library: read from Base, resolve transitive deps, install into a project.",
  "homepage": "https://gui.hanzo.ai",
  "license": "BSD-3-Clause",
  "author": "Hanzo AI <dev@hanzo.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/gui.git",
    "directory": "pkgs/recipes"
  },
  "source": "src/index.ts",
  "files": [
    "src",
    "types",
    "dist"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/esm/index.js",
      "browser": "./dist/esm/index.js",
      "module": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "hanzogui-build --skip-native",
    "test": "bun test",
    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
