{
  "name": "@hanzogui/sheet",
  "version": "8.3.2",
  "license": "MIT",
  "source": "src/index.ts",
  "files": [
    "dist",
    "next.md",
    "src",
    "types"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./types/index.d.ts",
  "typesVersions": {
    "*": {
      "setup-gesture-handler": [
        "./types/setupGestureHandler.d.ts"
      ]
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/native/index.js",
      "browser": "./dist/esm/index.js",
      "module": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./controller": {
      "types": "./types/controller.d.ts",
      "react-native": "./dist/native/controller.js",
      "browser": "./dist/esm/controller.js",
      "module": "./dist/esm/controller.js",
      "import": "./dist/esm/controller.js",
      "require": "./dist/cjs/controller.js",
      "default": "./dist/esm/controller.js"
    },
    "./setup-gesture-handler": {
      "types": "./types/setupGestureHandler.d.ts",
      "react-native": "./dist/native/setupGestureHandler.js",
      "browser": "./dist/esm/setupGestureHandler.js",
      "module": "./dist/esm/setupGestureHandler.js",
      "import": "./dist/esm/setupGestureHandler.js",
      "require": "./dist/cjs/setupGestureHandler.js",
      "default": "./dist/esm/setupGestureHandler.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "hanzogui-build",
    "watch": "hanzogui-build --watch",
    "clean": "hanzogui-build clean"
  },
  "dependencies": {
    "@hanzogui/adapt": "workspace:*",
    "@hanzogui/animate-presence": "workspace:*",
    "@hanzogui/animations-react-native": "workspace:*",
    "@hanzogui/compose-refs": "workspace:*",
    "@hanzogui/constants": "workspace:*",
    "@hanzogui/core": "workspace:*",
    "@hanzogui/create-context": "workspace:*",
    "@hanzogui/helpers": "workspace:*",
    "@hanzogui/native": "workspace:*",
    "@hanzogui/portal": "workspace:*",
    "@hanzogui/remove-scroll": "workspace:*",
    "@hanzogui/scroll-view": "workspace:*",
    "@hanzogui/stacks": "workspace:*",
    "@hanzogui/use-constant": "workspace:*",
    "@hanzogui/use-controllable-state": "workspace:*",
    "@hanzogui/use-did-finish-ssr": "workspace:*",
    "@hanzogui/use-keyboard-visible": "workspace:*",
    "@hanzogui/web": "workspace:*",
    "@hanzogui/z-index-stack": "workspace:*"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*",
    "react": "19.2.8",
    "react-native": "^0.87.1",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-safe-area-context": "^5.9.1"
  },
  "peerDependencies": {
    "react": ">=19.2.8"
  },
  "module:jsx": "dist/jsx",
  "removeSideEffects": true
}
