    "clean": "hanzogui-build clean",
    "clean:build": "hanzogui-build clean:build"
  },
  "devDependencies": {
    "@hanzogui/build": "workspace:*",
    "react-native-svg": "^15.15.5"
  },
  "peerDependencies": {
    "react-native-svg": ">=12"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    }
  }
